#!/usr/bin/env bash
# git pre-push hook: rejects pushes to main. It is the only local protection
# in private free-plan repos, and a second barrier in public ones.
# Installed by scripts/harness/install.sh and `make install-hooks`.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: push directo a main prohibido. Usa rama + PR." >&2
    exit 1
  fi
done
exit 0
