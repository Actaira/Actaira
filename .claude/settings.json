{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(az group delete*)",
      "Bash(az ad app delete*)",
      "Bash(stripe * --live*)",
      "Bash(git push --no-verify*)",
      "Bash(git tag -d*)",
      "Bash(git push --delete*)",
      "Bash(gh pr checkout*)",
      "Bash(git fetch *pull/*)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Bash(gh auth status*)",
      "Bash(git pull *pull/*)",
      "Bash(gh co *)"
    ],
    "allow": [
      "Bash(make *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run *)",
      "Bash(docker compose *)",
      "Bash(./scripts/*)",
      "Bash(git push -u origin e*)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only*)",
      "Bash(git tag e*-cerrada)",
      "Bash(git push origin e*-cerrada)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/harness/guard-git.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/harness/post-edit.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/harness/stop-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
