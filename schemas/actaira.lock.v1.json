{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actaira.com/schemas/actaira.lock.v1.json",
  "title": "actaira.lock, schema version 1",
  "description": "The capability lockfile (docs/epicas/E1.md, step 1.3; docs/cobertura.md; ADR 0002 and ADR 0004). Rules a schema cannot express (the canonical form: sorted keys and lists, no whitespace, integers written as digits, text in NFC) are checked by actaira, which reads only what it would write.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agents", "tools", "mcp_servers", "skills", "secret_refs", "edges", "coverage"],
  "properties": {
    "schema_version": { "const": 1 },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "mcp_servers": { "type": "array", "items": { "$ref": "#/$defs/mcp_server" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "secret_refs": { "type": "array", "items": { "$ref": "#/$defs/secret_ref" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "coverage": { "$ref": "#/$defs/coverage" },
    "intent": { "$ref": "acm.v0.json" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "confidence": { "enum": ["declared", "inferred", "conditional", "effective", "observed", "unresolved"] },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": { "column": ["line"] }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "framework", "source", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "framework": { "type": "string" },
        "source": { "$ref": "#/$defs/location" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "type": "string" } }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash"],
          "properties": { "hash": { "$ref": "#/$defs/hash" } }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "framework", "source", "effect", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "framework": { "type": "string" },
        "source": { "$ref": "#/$defs/location" },
        "schema_hash": { "$ref": "#/$defs/hash" },
        "description_hash": { "$ref": "#/$defs/hash" },
        "effect": { "const": "unknown" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "mcp_server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "transport", "pinned", "tools_source", "source", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "transport": { "enum": ["stdio", "http"] },
        "command": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ecosystem", "name"],
          "properties": {
            "ecosystem": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "pinned": { "type": "boolean" },
        "tools_source": { "const": "none" },
        "source": { "$ref": "#/$defs/location" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "allowed_tools", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "source": { "$ref": "#/$defs/location" },
        "allowed_tools": { "type": "array", "items": { "type": "string" } },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "secret_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "locations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "source", "confidence"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["can_call", "delegates_to", "uses_mcp_server", "references_env"] },
        "source": { "$ref": "#/$defs/location" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "locations", "state"],
      "properties": {
        "kind": { "enum": ["repo", "mcp_server", "env_ref"] },
        "name": { "type": "string" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
        "state": { "enum": ["observed", "not_configured", "error", "stale"] },
        "reason": { "type": "string", "minLength": 1 },
        "extractors": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "state": { "not": { "const": "observed" } } } }, "then": { "required": ["reason"] } },
        { "if": { "properties": { "kind": { "const": "repo" } } }, "then": { "required": ["extractors"] }, "else": { "not": { "required": ["extractors"] } } }
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis"],
      "properties": {
        "axis": { "enum": ["detected", "resolved", "unresolved", "effective", "effective_unused", "mediated", "governed"] },
        "value": { "$ref": "#/$defs/count" },
        "no_source": { "type": "string", "minLength": 1 }
      },
      "oneOf": [{ "required": ["value"] }, { "required": ["no_source"] }]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "kind", "reason"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "agents", "repo"],
      "properties": {
        "version": { "const": 1 },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "name", "sources", "axes", "unresolved"],
            "properties": {
              "agent": { "$ref": "#/$defs/id" },
              "name": { "type": "string" },
              "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
              "axes": { "type": "array", "items": { "$ref": "#/$defs/axis" } },
              "unresolved": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
            }
          }
        },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "unresolved", "skipped"],
          "properties": {
            "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
            "unresolved": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "reason"],
                "properties": { "path": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
